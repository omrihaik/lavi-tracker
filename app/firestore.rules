rules_version = '2';

// Only the two parents can read or write. Everyone else is rejected.
// These are anonymous Firebase user IDs — no names or emails in this public repo.
// To apply: Firebase console → Firestore → Rules → paste this file → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isParent() {
      return request.auth != null && request.auth.uid in [
        'VgerZgZfI3aMdQGVUveoNu8o8Ec2', // Parent 1 (Android)
        'qEJMfmRxG6fMhTAig6Yc8Ol9G332' // Parent 2 (iPhone)
      ];
    }

    match /events/{eventId} {
      allow read, write: if isParent();
    }
  }
}
